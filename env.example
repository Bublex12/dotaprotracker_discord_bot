# Discord Bot Configuration
# Скопируйте этот файл в .env.local и заполните реальными значениями
# Или добавьте их в переменные окружения Vercel для production

DISCORD_PUBLIC_KEY=your_public_key_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here

# Cloudflare на dota2protracker.com (обязательно для Vercel)
# 1. Откройте https://dota2protracker.com в Chrome, пройдите «Verify you are human»
# 2. F12 → Application → Cookies → https://dota2protracker.com
# 3. Скопируйте cf_clearance и __cf_bm (обновляйте раз в ~сутки при ошибках)
DOTA2PROTRACKER_COOKIES=cf_clearance=ВАШ_ТОКЕН; __cf_bm=ВАШ_ТОКЕН

